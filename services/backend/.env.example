# Copy this file to .env and adjust the values:
#   cp .env.example .env
# Variable names are case-insensitive (see app/core/config.py).

# --- Required ---

# Secret used to sign JWT access tokens. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# --- Optional (defaults shown) ---

# SQLAlchemy connection string. Default is a local SQLite file.
DATABASE_URL=sqlite:///./todo.db

# OpenAI API key for AI task prioritization.
# Leave empty to use the heuristic MockAIPriorityService instead.
OPENAI_API_KEY=

# JWT signing algorithm.
JWT_ALGORITHM=HS256

# Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60
